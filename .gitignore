.DS_Store
node_modules/
.env
.claude/settings.local.json
PROGRESS.md
TODO.md
STREAMING_PLAN.md

# Raw Azure table dumps — contain user/partition identifiers; fixtures are the artifact
evals/raw-drafts.json
# Azure Functions local settings — holds connection strings
api/local.settings.json
# Eval run outputs — regenerable, and they accumulate
evals/reports/
evals/*.log
evals/judgments/*-auto/
# ...but keep the roll-up: regenerating it costs a paid judging run
!evals/judgments/*-auto/_summary.json

# Synthetic OCR fixtures — regenerable and deterministic for a given --seed
# (node evals/ocr-fixtures/build.mjs), and several MB of PNGs. The builder is
# tracked; its output is not. A REAL screenshot plus its hand-written answer
# key is worth keeping: add it with `git add -f`.
evals/ocr-fixtures/*.png
evals/ocr-fixtures/*.json

# Judge calibration and re-judge runs — one file per response, regenerable by
# paying for another judging run. Same policy as the *-auto dirs: the per-
# response files are ignored, the _summary.json roll-up is force-added.
evals/judgments/calib-*/
evals/judgments/*-tier1-terra/
